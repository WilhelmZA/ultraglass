set interfaces ge-0/0/0 unit 0 family inet address 10.250.6.1/31
set interfaces ge-0/0/0 unit 0 family inet6 address fd00:250:6::1/127
set routing-options autonomous-system 65006
set routing-options router-id 10.250.6.1

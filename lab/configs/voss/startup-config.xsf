interface GigabitEthernet 1/1
no auto-sense enable
no shutdown
exit
vlan create 101 name LAB type port-mstprstp 0
vlan members add 101 1/1
interface vlan 101
ip address 10.251.3.1 255.255.255.252
exit
interface GigabitEthernet 1/1
default-vlan-id 101
exit
interface vlan 101
ipv6 interface enable
ipv6 interface address fd00:251:3::1/64
exit
router bgp 65023 enable
router bgp
neighbor 10.251.3.2
neighbor 10.251.3.2 remote-as 65000
neighbor 10.251.3.2 enable
neighbor fd00:251:3::2
neighbor fd00:251:3::2 remote-as 65000
neighbor fd00:251:3::2 address-family ipv6
neighbor fd00:251:3::2 enable
exit
